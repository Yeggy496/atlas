# Default demo parses a limited Chinese vocabulary locally, without a key.
LLM_PROVIDER=demo
# Set to openai or deepseek for real model-based parsing.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEEPSEEK_MODEL=deepseek-chat
# Optional base-URL override for an OpenAI-compatible gateway (blank = official endpoint).
OPENAI_BASE_URL=
DEEPSEEK_BASE_URL=
# Per-request model timeout in seconds; raise for slow self-hosted gateways.
OPENAI_TIMEOUT=35
DEEPSEEK_TIMEOUT=35
ATLAS_DB_PATH=atlas.db
# Low-CPU servers can use 30 seconds, one search worker, and 2-second repairs.
ATLAS_SOLVE_SECONDS=4
ATLAS_SOLVER_WORKERS=4
ATLAS_DIAGNOSIS_SECONDS=0.45
